# ==========================================
# UNST variable-font "dance" video (Colab)
# 1080x1080 MP4, black on white
# Renders "unst" using glyph IDs: u + n + st (ligature)
# Fixed font size: 128px
# Visually centered per-frame using the rendered bitmap bbox
# Animation path (with holds at each stop):
# (100,100) -> (400,100) -> (400,400) -> (25,400) -> (25,25) -> (100,100)
# ~2x longer than the previous version by doubling MOVE/HOLD durations
# Adds timestamp to output filename
# ==========================================

!pip -q install freetype-py pillow numpy tqdm imageio imageio-ffmpeg fonttools

import math
import numpy as np
from pathlib import Path
from PIL import Image
from tqdm import tqdm
import imageio.v2 as imageio
import freetype
from datetime import datetime
from typing import List, Tuple

from fontTools.ttLib import TTFont
from fontTools.varLib import instancer
from google.colab import files

# -----------------------------
# Upload variable font
# -----------------------------
uploaded = files.upload()
if not uploaded:
    raise SystemExit("No font uploaded.")

font_path = next(iter(uploaded.keys()))
print("Using font:", font_path)

base_tt = TTFont(font_path)
if "fvar" not in base_tt:
    raise RuntimeError("Not a variable font (missing fvar).")

axis_tags = [a.axisTag for a in base_tt["fvar"].axes]
print("Axes in font:", axis_tags)
if "wdth" not in axis_tags or "hght" not in axis_tags:
    raise RuntimeError("Expected axes wdth + hght.")

# -----------------------------
# Video settings
# -----------------------------
W, H = 1080, 1080
FPS = 30

# Fixed font size
FONT_PX = 128

WDTH_MIN, WDTH_MAX = 25.0, 400.0
HGHT_MIN, HGHT_MAX = 25.0, 400.0

# Holds / moves (about 2x longer than before)
HOLD_S = 1.00   # was 0.50
MOVE_S = 2.00   # was 1.00
HOLD_FR = int(round(HOLD_S * FPS))
MOVE_FR = int(round(MOVE_S * FPS))

# Instance caching (higher rounding reduces instancing jitter)
# Use 2.0 or 5.0 if you want faster rendering; 1.0 is smoother but heavier.
ROUND_TO = 1.0
CACHE_MAX = 64
inst_dir = Path("/tmp/unst_instances")
inst_dir.mkdir(parents=True, exist_ok=True)

_instance_cache = {}
_cache_usecount = {}

def q(v: float) -> float:
    return float(round(v / ROUND_TO) * ROUND_TO)

def instance_font_path(wdth: float, hght: float) -> Path:
    wd = q(np.clip(wdth, WDTH_MIN, WDTH_MAX))
    hg = q(np.clip(hght, HGHT_MIN, HGHT_MAX))
    key = (wd, hg)

    if key in _instance_cache:
        _cache_usecount[key] = _cache_usecount.get(key, 0) + 1
        return _instance_cache[key]

    if len(_instance_cache) >= CACHE_MAX:
        old = min(_cache_usecount, key=_cache_usecount.get)
        p_old = _instance_cache.pop(old, None)
        _cache_usecount.pop(old, None)
        if p_old and p_old.exists():
            try:
                p_old.unlink()
            except Exception:
                pass

    out_path = inst_dir / f"unst_w{wd:g}_h{hg:g}.ttf"
    tt = TTFont(font_path)
    inst_tt = instancer.instantiateVariableFont(tt, {"wdth": wd, "hght": hg}, inplace=False)
    inst_tt.save(out_path)

    _instance_cache[key] = out_path
    _cache_usecount[key] = 1
    return out_path

# -----------------------------
# Glyph-id lookup cache (u, n, st)
# -----------------------------
_glyphid_cache = {}

def glyph_ids_for_unst(inst_ttf_path: Path):
    key = str(inst_ttf_path)
    if key in _glyphid_cache:
        return _glyphid_cache[key]

    tt = TTFont(key)
    order = tt.getGlyphOrder()
    name_to_gid = {name: i for i, name in enumerate(order)}
    for needed in ["u", "n", "st"]:
        if needed not in name_to_gid:
            raise RuntimeError(f"Glyph '{needed}' not found in instanced font.")

    gids = [name_to_gid["u"], name_to_gid["n"], name_to_gid["st"]]
    upm = tt["head"].unitsPerEm
    hmtx = tt["hmtx"].metrics

    _glyphid_cache[key] = (gids, upm, order, hmtx)
    return _glyphid_cache[key]

# -----------------------------
# FreeType bitmap -> PIL mask (robust)
# -----------------------------
def ft_bitmap_to_mask(bmp: freetype.Bitmap) -> Image.Image:
    w, h = bmp.width, bmp.rows
    if w <= 0 or h <= 0:
        return Image.new("L", (1, 1), 0)

    buf = bmp.buffer
    if isinstance(buf, memoryview):
        buf = buf.tobytes()
    elif isinstance(buf, (list, tuple)):
        buf = bytes(buf)
    else:
        buf = bytes(buf)

    pitch = bmp.pitch
    flip = False
    if pitch < 0:
        pitch = -pitch
        flip = True

    if pitch == 0 or pitch == w:
        im = Image.frombytes("L", (w, h), buf)
    else:
        im = Image.frombytes("L", (w, h), buf, "raw", "L", pitch, 0)

    if flip:
        im = im.transpose(Image.FLIP_TOP_BOTTOM)

    return im

# -----------------------------
# Render visually centered "u n st"
# (centers using rendered bitmap bbox per frame)
# -----------------------------
def render_unst_centered(inst_path: Path, font_px: int) -> Image.Image:
    face = freetype.Face(str(inst_path))
    face.set_pixel_sizes(0, font_px)

    gids, upm, glyph_order, hmtx = glyph_ids_for_unst(inst_path)

    # Baseline is arbitrary; we'll re-center using final rendered bbox.
    baseline_y = H / 2.0

    img = Image.new("L", (W, H), 255)

    def paste_mask_clipped(dst: Image.Image, mask: Image.Image, x: int, y: int):
        bw, bh = mask.size
        x0, y0 = x, y
        x1, y1 = x + bw, y + bh

        ix0 = max(0, x0)
        iy0 = max(0, y0)
        ix1 = min(W, x1)
        iy1 = min(H, y1)
        if ix0 >= ix1 or iy0 >= iy1:
            return

        mx0 = ix0 - x0
        my0 = iy0 - y0
        mx1 = mx0 + (ix1 - ix0)
        my1 = my0 + (iy1 - iy0)

        m = mask.crop((mx0, my0, mx1, my1))
        dst.paste(0, (ix0, iy0, ix1, iy1), m)

    # First pass: render each glyph once, collect rendered bbox + masks
    pen_x = 0.0
    x_min, y_min = 1e9, 1e9
    x_max, y_max = -1e9, -1e9

    run = []  # (mask, left_px, top_px, adv_px)
    for gid in gids:
        face.load_glyph(gid, freetype.FT_LOAD_RENDER | freetype.FT_LOAD_TARGET_NORMAL)
        g = face.glyph
        bmp = g.bitmap
        bw, bh = bmp.width, bmp.rows

        # Pixel-accurate bitmap placement
        left = pen_x + g.bitmap_left
        top  = baseline_y - g.bitmap_top

        if bw > 0 and bh > 0:
            x0, y0 = left, top
            x1, y1 = left + bw, top + bh
            x_min = min(x_min, x0); y_min = min(y_min, y0)
            x_max = max(x_max, x1); y_max = max(y_max, y1)

        mask = ft_bitmap_to_mask(bmp)
        adv_px = g.advance.x / 64.0  # FreeType spacing for this instance/hinting
        run.append((mask, left, top, adv_px))
        pen_x += adv_px

    if x_max < x_min or y_max < y_min:
        return img.convert("RGB")

    # Center the ink bbox
    shift_x = (W / 2.0) - ((x_min + x_max) / 2.0)
    shift_y = (H / 2.0) - ((y_min + y_max) / 2.0)

    # Second pass: paste masks at centered positions
    for mask, left, top, adv_px in run:
        xi = int(round(left + shift_x))
        yi = int(round(top + shift_y))
        if mask.size[0] > 0 and mask.size[1] > 0:
            paste_mask_clipped(img, mask, xi, yi)

    return img.convert("RGB")

# -----------------------------
# Animation path with holds
# -----------------------------
def ease_in_out_sine(t: float) -> float:
    t = max(0.0, min(1.0, t))
    return 0.5 - 0.5 * math.cos(math.pi * t)

def lerp(a: float, b: float, t: float) -> float:
    return a + (b - a) * t

# Requested sequence:
states: List[Tuple[float, float]] = [
    (100.0, 100.0),
    (400.0, 100.0),
    (400.0, 400.0),
    (25.0,  400.0),
    (25.0,  25.0),
    (100.0, 25.0),
    (100.0, 100.0),
]

wd_seq: List[float] = []
hg_seq: List[float] = []

def append_hold(w: float, h: float):
    wd_seq.extend([w] * HOLD_FR)
    hg_seq.extend([h] * HOLD_FR)

def append_move(w0: float, h0: float, w1: float, h1: float):
    ts = np.linspace(0.0, 1.0, MOVE_FR + 1, endpoint=True)[1:]  # exclude t=0, include t=1
    for t in ts:
        tt = ease_in_out_sine(float(t))
        wd_seq.append(lerp(w0, w1, tt))
        hg_seq.append(lerp(h0, h1, tt))

# Build the full per-frame animation
w0, h0 = states[0]
append_hold(w0, h0)

for (w1, h1) in states[1:]:
    append_move(w0, h0, w1, h1)
    append_hold(w1, h1)
    w0, h0 = w1, h1

wdth_vals = np.clip(np.array(wd_seq, dtype=np.float64), WDTH_MIN, WDTH_MAX)
hght_vals = np.clip(np.array(hg_seq, dtype=np.float64), HGHT_MIN, HGHT_MAX)

N_FRAMES = int(wdth_vals.shape[0])
DURATION_S = N_FRAMES / FPS

ts = datetime.utcnow().strftime("%Y%m%d-%H%M%S")
OUT_MP4 = f"unst-dance-1080-{ts}.mp4"

print(f"FONT_PX: {FONT_PX}")
print(f"HOLD_FR: {HOLD_FR}  MOVE_FR: {MOVE_FR}")
print(f"Frames: {N_FRAMES}  Duration: {DURATION_S:.2f}s  FPS: {FPS}")
print("Output:", OUT_MP4)

# -----------------------------
# Render video
# -----------------------------
writer = imageio.get_writer(
    OUT_MP4,
    fps=FPS,
    codec="libx264",
    quality=8,
    pixelformat="yuv420p"
)

print("Rendering video...")
for i in tqdm(range(N_FRAMES)):
    inst_path = instance_font_path(float(wdth_vals[i]), float(hght_vals[i]))
    frame = render_unst_centered(inst_path, FONT_PX)
    writer.append_data(np.array(frame))

writer.close()
print("Wrote:", OUT_MP4)

# Preview + download
from IPython.display import HTML
from base64 import b64encode

mp4 = Path(OUT_MP4).read_bytes()
data_url = "data:video/mp4;base64," + b64encode(mp4).decode()
HTML(f"""
<video width="{W}" height="{H}" controls loop>
  <source src="{data_url}" type="video/mp4">
</video>
""")

files.download(OUT_MP4)
