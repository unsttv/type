# ==========================================
# UNST variable-font "dance" video (Colab)
# 1080x1080 MP4, black on white
# Smooth, eased keyframed animation (12s) with a few big moves
# Renders "unst" using glyph IDs: u + n + st (ligature)
# Adds timestamp to output filename
# ==========================================

!pip -q install freetype-py pillow numpy tqdm imageio imageio-ffmpeg fonttools

import math
import numpy as np
from pathlib import Path
from PIL import Image
from tqdm import tqdm
import imageio.v2 as imageio
import freetype
from datetime import datetime

from fontTools.ttLib import TTFont
from fontTools.varLib import instancer
from google.colab import files

# -----------------------------
# Upload variable font
# -----------------------------
uploaded = files.upload()
if not uploaded:
    raise SystemExit("No font uploaded.")

font_path = next(iter(uploaded.keys()))
print("Using font:", font_path)

base_tt = TTFont(font_path)
if "fvar" not in base_tt:
    raise RuntimeError("Not a variable font (missing fvar).")

axis_tags = [a.axisTag for a in base_tt["fvar"].axes]
print("Axes in font:", axis_tags)
if "wdth" not in axis_tags or "hght" not in axis_tags:
    raise RuntimeError("Expected axes wdth + hght.")

# -----------------------------
# Video settings
# -----------------------------
W, H = 1080, 1080
FPS = 30
DURATION_S = 12.0
N_FRAMES = int(round(FPS * DURATION_S))

ts = datetime.utcnow().strftime("%Y%m%d-%H%M%S")
OUT_MP4 = f"unst-dance-1080-{ts}.mp4"

WDTH_MIN, WDTH_MAX = 25.0, 400.0
HGHT_MIN, HGHT_MAX = 25.0, 400.0

MARGIN = 70

# Instance caching (higher rounding reduces instancing jitter)
# Use 2.0 or 5.0 if you want faster rendering; 1.0 is smoother but heavier.
ROUND_TO = 1.0
CACHE_MAX = 64
inst_dir = Path("/tmp/unst_instances")
inst_dir.mkdir(parents=True, exist_ok=True)

_instance_cache = {}
_cache_usecount = {}

def q(v: float) -> float:
    return float(round(v / ROUND_TO) * ROUND_TO)

def instance_font_path(wdth: float, hght: float) -> Path:
    wd = q(np.clip(wdth, WDTH_MIN, WDTH_MAX))
    hg = q(np.clip(hght, HGHT_MIN, HGHT_MAX))
    key = (wd, hg)

    if key in _instance_cache:
        _cache_usecount[key] = _cache_usecount.get(key, 0) + 1
        return _instance_cache[key]

    if len(_instance_cache) >= CACHE_MAX:
        old = min(_cache_usecount, key=_cache_usecount.get)
        p_old = _instance_cache.pop(old, None)
        _cache_usecount.pop(old, None)
        if p_old and p_old.exists():
            try:
                p_old.unlink()
            except Exception:
                pass

    out_path = inst_dir / f"unst_w{wd:g}_h{hg:g}.ttf"
    tt = TTFont(font_path)
    inst_tt = instancer.instantiateVariableFont(tt, {"wdth": wd, "hght": hg}, inplace=False)
    inst_tt.save(out_path)

    _instance_cache[key] = out_path
    _cache_usecount[key] = 1
    return out_path

# -----------------------------
# Glyph-id lookup cache (u, n, st)
# -----------------------------
_glyphid_cache = {}

def glyph_ids_for_unst(inst_ttf_path: Path):
    key = str(inst_ttf_path)
    if key in _glyphid_cache:
        return _glyphid_cache[key]

    tt = TTFont(key)
    order = tt.getGlyphOrder()
    name_to_gid = {name: i for i, name in enumerate(order)}
    for needed in ["u", "n", "st"]:
        if needed not in name_to_gid:
            raise RuntimeError(f"Glyph '{needed}' not found in instanced font.")

    gids = [name_to_gid["u"], name_to_gid["n"], name_to_gid["st"]]
    upm = tt["head"].unitsPerEm
    hmtx = tt["hmtx"].metrics

    _glyphid_cache[key] = (gids, upm, order, hmtx)
    return _glyphid_cache[key]

# -----------------------------
# FreeType bitmap -> PIL mask (robust)
# -----------------------------
def ft_bitmap_to_mask(bmp: freetype.Bitmap) -> Image.Image:
    w, h = bmp.width, bmp.rows
    if w <= 0 or h <= 0:
        return Image.new("L", (1, 1), 0)

    buf = bmp.buffer
    if isinstance(buf, memoryview):
        buf = buf.tobytes()
    elif isinstance(buf, (list, tuple)):
        buf = bytes(buf)
    else:
        buf = bytes(buf)

    pitch = bmp.pitch
    flip = False
    if pitch < 0:
        pitch = -pitch
        flip = True

    if pitch == 0 or pitch == w:
        im = Image.frombytes("L", (w, h), buf)
    else:
        im = Image.frombytes("L", (w, h), buf, "raw", "L", pitch, 0)

    if flip:
        im = im.transpose(Image.FLIP_TOP_BOTTOM)

    return im

# -----------------------------
# Render centered "u n st"
# -----------------------------
def render_unst_centered(inst_path: Path, font_px: int) -> Image.Image:
    face = freetype.Face(str(inst_path))
    face.set_pixel_sizes(0, font_px)

    gids, upm, glyph_order, hmtx = glyph_ids_for_unst(inst_path)
    scale = font_px / upm

    asc = face.size.ascender / 64.0
    desc = face.size.descender / 64.0
    baseline_y = (H / 2.0) + (asc + desc) / 2.0

    # Measure bbox for centering
    pen_x = 0.0
    x_min, y_min = 1e9, 1e9
    x_max, y_max = -1e9, -1e9

    run = []
    for gid in gids:
        face.load_glyph(gid, freetype.FT_LOAD_DEFAULT)
        g = face.glyph

        left = pen_x + g.metrics.horiBearingX / 64.0
        top  = baseline_y - g.metrics.horiBearingY / 64.0
        gw   = g.metrics.width / 64.0
        gh   = g.metrics.height / 64.0

        x0, y0 = left, top
        x1, y1 = left + gw, top + gh

        x_min = min(x_min, x0)
        y_min = min(y_min, y0)
        x_max = max(x_max, x1)
        y_max = max(y_max, y1)

        gname = glyph_order[gid]
        adv_fu = hmtx[gname][0]
        adv_px = adv_fu * scale

        run.append((gid, adv_px))
        pen_x += adv_px

    shift_x = (W / 2.0) - ((x_min + x_max) / 2.0)
    shift_y = (H / 2.0) - ((y_min + y_max) / 2.0)

    img = Image.new("L", (W, H), 255)
    pen_x = 0.0

    for gid, adv_px in run:
        face.load_glyph(gid, freetype.FT_LOAD_RENDER | freetype.FT_LOAD_TARGET_NORMAL)
        g = face.glyph
        bmp = g.bitmap
        bw, bh = bmp.width, bmp.rows

        if bw > 0 and bh > 0:
            x = (pen_x + g.bitmap_left) + shift_x
            y = (baseline_y - g.bitmap_top) + shift_y
            xi, yi = int(round(x)), int(round(y))
            mask = ft_bitmap_to_mask(bmp)
            img.paste(0, (xi, yi, xi + bw, yi + bh), mask)

        pen_x += adv_px

    return img.convert("RGB")

# -----------------------------
# Easing + keyframed axis curves
# -----------------------------
def smoothstep(t: float) -> float:
    # classic cubic smoothstep
    t = max(0.0, min(1.0, t))
    return t * t * (3.0 - 2.0 * t)

def ease_in_out_sine(t: float) -> float:
    t = max(0.0, min(1.0, t))
    return 0.5 - 0.5 * math.cos(math.pi * t)

def lerp(a: float, b: float, t: float) -> float:
    return a + (b - a) * t

def keyframed_curve(frames: int, keyframes: list[tuple[int, float]], easing="sine") -> np.ndarray:
    """
    keyframes: list of (frame_index, value), must be sorted by frame_index
    """
    if keyframes[0][0] != 0 or keyframes[-1][0] != frames - 1:
        raise ValueError("Keyframes must start at 0 and end at frames-1.")

    out = np.zeros(frames, dtype=np.float64)

    for (f0, v0), (f1, v1) in zip(keyframes[:-1], keyframes[1:]):
        span = max(1, f1 - f0)
        for i in range(f0, f1 + 1):
            t = (i - f0) / span
            if easing == "smoothstep":
                tt = smoothstep(t)
            else:
                tt = ease_in_out_sine(t)
            out[i] = lerp(v0, v1, tt)

    return out

# A few big moves over 12 seconds.
# Start at 100/100, visit extremes, return to 100/100.
# (You can tweak these values; these are intentionally bold but not constant extremes.)

# frame indices
F0 = 0
F1 = int(0.22 * (N_FRAMES - 1))
F2 = int(0.42 * (N_FRAMES - 1))
F3 = int(0.62 * (N_FRAMES - 1))
F4 = int(0.82 * (N_FRAMES - 1))
F5 = N_FRAMES - 1

wdth_keys = [
    (F0, 100.0),
    (F1, 380.0),   # wide
    (F2, 55.0),    # narrow
    (F3, 300.0),   # wide-ish
    (F4, 100.0),   # back to normal
    (F5, 100.0),
]

hght_keys = [
    (F0, 100.0),
    (F1, 55.0),    # short
    (F2, 360.0),   # tall
    (F3, 130.0),   # moderate
    (F4, 390.0),   # tall-ish
    (F5, 100.0),
]

wdth_vals = keyframed_curve(N_FRAMES, wdth_keys, easing="sine")
hght_vals = keyframed_curve(N_FRAMES, hght_keys, easing="sine")

# Add a *tiny* organic wobble so it doesn't feel robotic (very low amplitude).
t = np.linspace(0, DURATION_S, N_FRAMES, endpoint=False)
wdth_vals *= (1.0 + 0.012 * np.sin(2 * np.pi * 0.35 * t + 0.2))
hght_vals *= (1.0 + 0.012 * np.sin(2 * np.pi * 0.31 * t + 1.0))

wdth_vals = np.clip(wdth_vals, WDTH_MIN, WDTH_MAX)
hght_vals = np.clip(hght_vals, HGHT_MIN, HGHT_MAX)
wdth_vals[0] = 100.0
hght_vals[0] = 100.0

# -----------------------------
# Auto-fit font size at 100/100
# -----------------------------
def fits(font_px: int) -> bool:
    inst_path = instance_font_path(100.0, 100.0)
    img = render_unst_centered(inst_path, font_px)
    arr = np.array(img)[:, :, 0]
    ys, xs = np.where(arr < 250)
    if len(xs) == 0:
        return False
    x0, x1 = xs.min(), xs.max()
    y0, y1 = ys.min(), ys.max()
    return (x0 >= MARGIN and y0 >= MARGIN and x1 <= W - MARGIN and y1 <= H - MARGIN)

lo, hi = 20, 520
best = 200
for _ in range(11):
    mid = (lo + hi) // 2
    if fits(mid):
        best = mid
        lo = mid + 1
    else:
        hi = mid - 1

FONT_PX = best
print("Chosen FONT_PX:", FONT_PX)
print("Output:", OUT_MP4)

# -----------------------------
# Render video
# -----------------------------
writer = imageio.get_writer(
    OUT_MP4,
    fps=FPS,
    codec="libx264",
    quality=8,
    pixelformat="yuv420p"
)

print("Rendering video...")
for i in tqdm(range(N_FRAMES)):
    inst_path = instance_font_path(float(wdth_vals[i]), float(hght_vals[i]))
    frame = render_unst_centered(inst_path, FONT_PX)
    writer.append_data(np.array(frame))

writer.close()
print("Wrote:", OUT_MP4)

# Preview + download
from IPython.display import HTML
from base64 import b64encode

mp4 = Path(OUT_MP4).read_bytes()
data_url = "data:video/mp4;base64," + b64encode(mp4).decode()
HTML(f"""
<video width="{W}" height="{H}" controls loop>
  <source src="{data_url}" type="video/mp4">
</video>
""")

files.download(OUT_MP4)
